# Database — Supabase PostgreSQL
# Get from: Project Settings → Database → Connection string → URI
DATABASE_URL="postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres"

# NextAuth
AUTH_SECRET="your-secret-key-change-this"
AUTH_URL="http://localhost:3000"

# Site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin maintenance credentials
# Used only by explicit seed/password-rotation tooling. Runtime authentication
# is database-only and does not read these variables as a login fallback.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Contact notification email (where form submissions are sent)
CONTACT_EMAIL="your-email@example.com"

# Email notifications (Resend HTTP API — https://resend.com)
# Sender must be a verified domain or the default onboarding@resend.dev sender.
RESEND_API_KEY=""
CONTACT_FROM_EMAIL="Meed Portfolio <onboarding@resend.dev>"

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
