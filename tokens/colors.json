{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Abdulhameed Portfolio Design Tokens",
  "version": "1.1.0",

  "color": {
    "primary": {
      "base": "hsl(150, 55%, 32%)",
      "foreground": "hsl(150, 0%, 100%)",
      "hover": "hsl(150, 55%, 27%)",
      "active": "hsl(150, 55%, 22%)",
      "subtle": "hsl(150, 55%, 95%)"
    },

    "secondary": {
      "base": "hsl(150, 20%, 3%)",
      "foreground": "hsl(150, 0%, 100%)",
      "hover": "hsl(150, 20%, 8%)",
      "active": "hsl(150, 20%, 12%)",
      "subtle": "hsl(150, 10%, 96%)"
    },

    "tertiary": {
      "base": "hsl(150, 5%, 30%)",
      "foreground": "hsl(150, 0%, 100%)",
      "hover": "hsl(150, 5%, 25%)",
      "active": "hsl(150, 5%, 20%)",
      "subtle": "hsl(150, 5%, 95%)"
    },

    "neutral": {
      "50": "hsl(150, 3%, 98%)",
      "100": "hsl(150, 3%, 96%)",
      "200": "hsl(150, 3%, 92%)",
      "300": "hsl(150, 3%, 88%)",
      "400": "hsl(150, 3%, 80%)",
      "500": "hsl(150, 3%, 65%)",
      "600": "hsl(150, 3%, 50%)",
      "700": "hsl(150, 3%, 35%)",
      "800": "hsl(150, 3%, 20%)",
      "900": "hsl(150, 3%, 10%)",
      "950": "hsl(150, 3%, 5%)"
    }
  },

  "theme": {
    "light": {
      "background": {
        "primary": "hsl(150, 0%, 100%)",
        "secondary": "hsl(150, 3%, 98%)",
        "tertiary": "hsl(150, 3%, 96%)",
        "inverse": "hsl(150, 20%, 3%)"
      },

      "surface": {
        "primary": "hsl(150, 0%, 100%)",
        "secondary": "hsl(150, 3%, 96%)",
        "tertiary": "hsl(150, 3%, 92%)",
        "elevated": "hsl(150, 0%, 100%)"
      },

      "text": {
        "primary": "hsl(150, 20%, 3%)",
        "secondary": "hsl(150, 5%, 30%)",
        "tertiary": "hsl(150, 3%, 50%)",
        "inverse": "hsl(150, 0%, 100%)",
        "accent": "hsl(150, 55%, 32%)"
      },

      "border": {
        "subtle": "hsl(150, 3%, 92%)",
        "default": "hsl(150, 3%, 88%)",
        "strong": "hsl(150, 3%, 80%)",
        "accent": "hsl(150, 55%, 32%)"
      },

      "button": {
        "primary": {
          "background": "hsl(150, 55%, 32%)",
          "foreground": "hsl(150, 0%, 100%)"
        },
        "secondary": {
          "background": "hsl(150, 20%, 3%)",
          "foreground": "hsl(150, 0%, 100%)"
        }
      },

      "focus": {
        "ring": "hsl(150, 55%, 32%)"
      }
    },

    "dark": {
      "background": {
        "primary": "hsl(150, 20%, 3%)",
        "secondary": "hsl(150, 10%, 5%)",
        "tertiary": "hsl(150, 5%, 8%)",
        "inverse": "hsl(150, 0%, 100%)"
      },

      "surface": {
        "primary": "hsl(150, 10%, 6%)",
        "secondary": "hsl(150, 8%, 9%)",
        "tertiary": "hsl(150, 5%, 12%)",
        "elevated": "hsl(150, 8%, 10%)"
      },

      "text": {
        "primary": "hsl(150, 0%, 100%)",
        "secondary": "hsl(150, 3%, 82%)",
        "tertiary": "hsl(150, 3%, 65%)",
        "inverse": "hsl(150, 20%, 3%)",
        "accent": "hsl(150, 55%, 60%)"
      },

      "border": {
        "subtle": "hsl(150, 5%, 14%)",
        "default": "hsl(150, 5%, 18%)",
        "strong": "hsl(150, 5%, 24%)",
        "accent": "hsl(150, 55%, 60%)"
      },

      "button": {
        "primary": {
          "background": "hsl(150, 55%, 60%)",
          "foreground": "hsl(150, 20%, 3%)"
        },
        "secondary": {
          "background": "hsl(150, 0%, 100%)",
          "foreground": "hsl(150, 20%, 3%)"
        }
      },

      "focus": {
        "ring": "hsl(150, 55%, 60%)"
      }
    }
  }
}
