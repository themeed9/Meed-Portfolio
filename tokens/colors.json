{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Abdulhameed Portfolio Design Tokens",
  "version": "1.0.0",

  "color": {
    "primary": {
      "base": "hsl(63, 100%, 35%)",
      "foreground": "hsl(63, 0%, 100%)",
      "hover": "hsl(63, 100%, 30%)",
      "active": "hsl(63, 100%, 25%)",
      "subtle": "hsl(63, 100%, 95%)"
    },

    "secondary": {
      "base": "hsl(63, 100%, 3%)",
      "foreground": "hsl(63, 0%, 100%)",
      "hover": "hsl(63, 100%, 8%)",
      "active": "hsl(63, 100%, 12%)",
      "subtle": "hsl(63, 20%, 96%)"
    },

    "tertiary": {
      "base": "hsl(63, 6%, 30%)",
      "foreground": "hsl(63, 0%, 100%)",
      "hover": "hsl(63, 6%, 25%)",
      "active": "hsl(63, 6%, 20%)",
      "subtle": "hsl(63, 8%, 95%)"
    },

    "neutral": {
      "50": "hsl(63, 3%, 98%)",
      "100": "hsl(63, 3%, 96%)",
      "200": "hsl(63, 3%, 92%)",
      "300": "hsl(63, 3%, 88%)",
      "400": "hsl(63, 3%, 80%)",
      "500": "hsl(63, 3%, 65%)",
      "600": "hsl(63, 3%, 50%)",
      "700": "hsl(63, 3%, 35%)",
      "800": "hsl(63, 3%, 20%)",
      "900": "hsl(63, 3%, 10%)",
      "950": "hsl(63, 3%, 5%)"
    }
  },

  "theme": {
    "light": {
      "background": {
        "primary": "hsl(63, 0%, 100%)",
        "secondary": "hsl(63, 3%, 98%)",
        "tertiary": "hsl(63, 3%, 96%)",
        "inverse": "hsl(63, 100%, 3%)"
      },

      "surface": {
        "primary": "hsl(63, 0%, 100%)",
        "secondary": "hsl(63, 3%, 96%)",
        "tertiary": "hsl(63, 3%, 92%)",
        "elevated": "hsl(63, 0%, 100%)"
      },

      "text": {
        "primary": "hsl(63, 100%, 3%)",
        "secondary": "hsl(63, 6%, 30%)",
        "tertiary": "hsl(63, 3%, 50%)",
        "inverse": "hsl(63, 0%, 100%)",
        "accent": "hsl(63, 100%, 35%)"
      },

      "border": {
        "subtle": "hsl(63, 3%, 92%)",
        "default": "hsl(63, 3%, 88%)",
        "strong": "hsl(63, 3%, 80%)",
        "accent": "hsl(63, 100%, 35%)"
      },

      "button": {
        "primary": {
          "background": "hsl(63, 100%, 35%)",
          "foreground": "hsl(63, 100%, 3%)"
        },
        "secondary": {
          "background": "hsl(63, 100%, 3%)",
          "foreground": "hsl(63, 0%, 100%)"
        }
      },

      "focus": {
        "ring": "hsl(63, 100%, 35%)"
      }
    },

    "dark": {
      "background": {
        "primary": "hsl(63, 100%, 3%)",
        "secondary": "hsl(63, 20%, 5%)",
        "tertiary": "hsl(63, 10%, 8%)",
        "inverse": "hsl(63, 0%, 100%)"
      },

      "surface": {
        "primary": "hsl(63, 18%, 6%)",
        "secondary": "hsl(63, 12%, 9%)",
        "tertiary": "hsl(63, 8%, 12%)",
        "elevated": "hsl(63, 10%, 10%)"
      },

      "text": {
        "primary": "hsl(63, 0%, 100%)",
        "secondary": "hsl(63, 3%, 82%)",
        "tertiary": "hsl(63, 3%, 65%)",
        "inverse": "hsl(63, 100%, 3%)",
        "accent": "hsl(63, 100%, 45%)"
      },

      "border": {
        "subtle": "hsl(63, 8%, 14%)",
        "default": "hsl(63, 8%, 18%)",
        "strong": "hsl(63, 8%, 24%)",
        "accent": "hsl(63, 100%, 45%)"
      },

      "button": {
        "primary": {
          "background": "hsl(63, 100%, 45%)",
          "foreground": "hsl(63, 100%, 3%)"
        },
        "secondary": {
          "background": "hsl(63, 0%, 100%)",
          "foreground": "hsl(63, 100%, 3%)"
        }
      },

      "focus": {
        "ring": "hsl(63, 100%, 45%)"
      }
    }
  }
}
