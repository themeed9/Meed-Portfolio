{
  "typography": {
    "fontFamily": {
      "primary": "Geist, sans-serif"
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "fontSize": {
      "displayXL": "5rem",
      "displayLG": "4rem",
      "headingXL": "3rem",
      "headingLG": "2.5rem",
      "headingMD": "2rem",
      "titleXL": "1.75rem",
      "titleLG": "1.5rem",
      "titleMD": "1.25rem",
      "bodyLG": "1.125rem",
      "bodyMD": "1rem",
      "bodySM": "0.875rem",
      "labelLG": "1rem",
      "labelMD": "0.875rem",
      "labelSM": "0.75rem"
    },
    "lineHeight": {
      "display": 1.05,
      "heading": 1.15,
      "title": 1.3,
      "body": 1.7,
      "label": 1.4
    }
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "7": "32px",
    "8": "40px",
    "9": "48px",
    "10": "64px",
    "11": "80px",
    "12": "96px",
    "13": "120px",
    "14": "160px",
    "15": "200px"
  },
  "layout": {
    "contentWidth": {
      "reading": "720px",
      "standard": "1200px",
      "wide": "1440px"
    },
    "grid": {
      "desktop": {
        "columns": 12,
        "gutter": "24px"
      },
      "tablet": {
        "columns": 8,
        "gutter": "20px"
      },
      "mobile": {
        "columns": 4,
        "gutter": "16px"
      }
    }
  },
  "borderRadius": {
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px",
    "2xl": "32px"
  },
  "elevation": {
    "level1": "0 1px 2px rgba(0,0,0,.06)",
    "level2": "0 8px 24px rgba(0,0,0,.08)",
    "level3": "0 24px 48px rgba(0,0,0,.12)"
  },
  "transition": {
    "duration": {
      "fast": "150ms",
      "normal": "200ms",
      "slow": "300ms",
      "max": "400ms"
    },
    "easing": "ease-out"
  },
  "breakpoint": {
    "mobile": "320px",
    "tablet": "768px",
    "desktop": "1024px",
    "largeDesktop": "1440px"
  }
}
